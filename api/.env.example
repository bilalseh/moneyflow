# Runtime environment: "development" | "production" | "test"
MONEYFLOW_ENV=development

# Firebase project whose ID tokens this API accepts
MONEYFLOW_FIREBASE_PROJECT_ID=moneyflow-coach

# Google Gemini API key (free tier). Lives only here, never in the web app.
MONEYFLOW_GEMINI_API_KEY=

# Comma-separated list of allowed browser origins for CORS.
# In production the web app is same-origin via the Hosting rewrite, so this
# only matters for local development.
MONEYFLOW_CORS_ORIGINS=http://localhost:5173

# Point the Firebase Admin SDK at the local Auth emulator when developing offline
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
