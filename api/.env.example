# Runtime environment: "development" | "production" | "test"
MONEYFLOW_ENV=development

# Firebase project whose ID tokens this API accepts (audience check).
# Production uses Application Default Credentials for Firestore and Auth.
MONEYFLOW_FIREBASE_PROJECT_ID=moneyflow-coach

# Comma-separated list of allowed browser origins for CORS, as a JSON list.
# In production the web app is same-origin via the Hosting rewrite, so this
# only matters for local development.
MONEYFLOW_CORS_ORIGINS=["http://localhost:5173"]

# Google Gemini API key (free tier). Lives only here, never in the web app.
# Empty means AI is off: routes serve deterministic fallbacks (categorize: 503).
MONEYFLOW_GEMINI_API_KEY=
MONEYFLOW_GEMINI_MODEL=gemini-2.5-flash
MONEYFLOW_GEMINI_TIMEOUT_SECONDS=20

# Stripe, test mode only. Billing is enabled only for keys starting with
# sk_test_; any other key (including live keys) is logged and ignored.
MONEYFLOW_STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Empty means the webhook route returns 503.
MONEYFLOW_STRIPE_WEBHOOK_SECRET=
MONEYFLOW_PRO_PRICE_CENTS=500

# Public URL of the web app, used for Stripe success and cancel URLs.
MONEYFLOW_APP_URL=https://moneyflow-coach.web.app

# Daily AI request quota per user and plan (resets at UTC midnight).
MONEYFLOW_FREE_DAILY_AI=20
MONEYFLOW_PRO_DAILY_AI=200

# Point the Firebase Admin SDK at the local emulators when developing offline
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
