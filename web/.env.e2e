# End-to-end tests run against the local Firebase emulators. These values are
# not secrets: "demo-" projects only exist inside the emulator.
VITE_FIREBASE_API_KEY=e2e-demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-moneyflow
VITE_FIREBASE_STORAGE_BUCKET=demo-moneyflow.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_USE_EMULATORS=true
VITE_API_BASE_URL=/api
