# Firebase web config. These values are public by design; access control is
# enforced by Firestore security rules and Firebase Auth, not by hiding the key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=moneyflow-coach.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=moneyflow-coach
VITE_FIREBASE_STORAGE_BUCKET=moneyflow-coach.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at local Firebase emulators
VITE_USE_EMULATORS=false

# API base path. Same origin in production thanks to the Hosting rewrite to Cloud Run.
VITE_API_BASE_URL=/api
