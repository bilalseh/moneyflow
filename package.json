{
  "name": "moneyflow",
  "private": true,
  "version": "0.1.0",
  "description": "Moneyflow: a personal money coach. Educational tool, not financial advice.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @moneyflow/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "cd api && uv run uvicorn moneyflow_api.main:app --reload --port 8080",
    "api:test": "cd api && uv run pytest",
    "api:lint": "cd api && uv run ruff check . && uv run ruff format --check . && uv run mypy .",
    "emulators": "firebase emulators:start --only auth,firestore",
    "rules:test": "pnpm --filter @moneyflow/web test:rules"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
